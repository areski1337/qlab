{
  "name": "qlab-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "QLab — plateforme locale de recherche quantitative",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "local.qlab.desktop",
    "productName": "QLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "dist/renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine",
        "filter": [
          "pyproject.toml",
          "uv.lock",
          ".python-version",
          "README.md",
          "src/**",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "build/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ]
    },
    "asar": true,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "QLab"
    }
  }
}